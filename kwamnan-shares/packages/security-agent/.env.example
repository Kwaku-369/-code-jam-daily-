# Supabase connection
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Agent behaviour (optional overrides)
THREAT_POLL_INTERVAL_SECONDS=60
ANOMALY_POLL_INTERVAL_SECONDS=300
DUPLICATE_SCAN_INTERVAL_HOURS=6

# Logging
LOG_LEVEL=INFO

# Environment tag shown in alerts
ENVIRONMENT=production
