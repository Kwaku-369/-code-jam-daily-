# ============================================================
# KWAMNAN SHARES - Frontend Environment Variables
# Copy to .env.local and fill in your values
# ============================================================

# Supabase (get from supabase.com dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY

# Cloudflare Worker API URL (set after deploying worker)
NEXT_PUBLIC_API_URL=https://kwamnan-shares-api.YOUR_SUBDOMAIN.workers.dev

# Paystack public key (safe to expose in frontend)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_YOUR_PUBLIC_KEY

# App URL
NEXT_PUBLIC_APP_URL=https://kwamnan-shares.pages.dev
