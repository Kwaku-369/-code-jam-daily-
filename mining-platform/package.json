{
  "name": "mining-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev":     "turbo run dev",
    "build":   "turbo run build",
    "test":    "turbo run test",
    "deploy":  "turbo run deploy",
    "lint":    "turbo run lint",
    "typecheck":"turbo run typecheck",
    "db:migrate": "wrangler d1 migrations apply mining-platform-db --remote",
    "db:seed":    "node scripts/seed.js"
  },
  "devDependencies": {
    "turbo":        "^2.3.0",
    "typescript":   "^5.7.0",
    "@types/node":  "^22.0.0",
    "vitest":       "^2.1.0",
    "@vitest/coverage-v8": "^2.1.0",
    "prettier":     "^3.4.0",
    "eslint":       "^9.0.0",
    "wrangler":     "^3.95.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
